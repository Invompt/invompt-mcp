{
  "name": "@invompt/mcp-testkit",
  "version": "0.10.3",
  "private": true,
  "description": "Contract fixtures for Invompt MCP integrations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "https://github.com/Invompt/invompt-mcp.git" },
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": { "@invompt/mcp-core": "0.10.3" },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "verify:pack": "npm run build"
  }
}
